Mods: {
	CalamityRangerExpansion: {
		Gel: {
			APreHardMode: {
				GeliticGel: {
					DisplayName: 双色凝胶
					Tooltip:
						'''
						在邪恶地形造成血肉沸腾和大脑溃烂
						在神圣地形造成神圣之火和困惑
						在任意地形造成史莱姆减益
						“给你的敌人两种颜色（物理）瞧瞧”
						'''
				}
		
				HurricaneGel: {
					DisplayName: 棱晶凝胶
					Tooltip:
						'''
						击中敌人时爆出水晶碎片
						水晶碎片有数量限制
						“什么？你说这是他们的肾结石？”
						'''
				}
		
				WulfrimGel: {
					DisplayName: 钨钢凝胶
					Tooltip:
						'''
						每一秒额外造成几点奖励伤害
						“你什么时候奖励自己”
						'''
				}
		
				AerialiteGel: {
					DisplayName: 天蓝凝胶
					Tooltip:
						'''
						每5秒在原地释放一个滞留的筋斗云产生极高伤害
						同时把玩家以很大的速度往后推
						“俺老孙来也！”
						'''
				}

				AerialiteGelCloud.DisplayName: 筋斗云
				HurricaneGelSplit.DisplayName: 水晶碎片
			}
		}
	}
}
