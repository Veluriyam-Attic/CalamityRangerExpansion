Mods: {
	CalamityRangerExpansion: {
		DeveloperItems: {
			TheGoldenFire: {
				TheGoldenFire: {
					CommonTooltip:
						'''
						曾记否？
						往昔的辉煌，和那于翻天覆地的变革叱咤的身影？
						辉煌得以延续，沉寂的土地在岁月的洗礼中，悄然焕发出新的生机
						[c/FFDB39:而今，凤凰涅槃，重获新生……]
						'''
					DisplayName: 虞金引焱
					Tooltip: "[Stage]"
					TooltipS0:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:壹]
						[c/FFD700:世事沧桑，历史的车轮滚滚向前……]
						[c/FFD700:即便已经过去了许久，它们仍在畏惧着你！]
						[c/FFD700:一个血淋淋的眼睛奉旨来监视你]
						[c/D00000:你将选择继续忍耐，还是振臂高举反叛之剑，向苍穹呐喊？]
						[c/CB0000:“我曾看到，神抛弃了这个世界”]
						'''
					TooltipS1S:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:貳]
						[c/FFD700:昔日的主宰已经沦落至如此不堪之境]
						[c/FFD700:曾经的争斗已成为过眼云烟]
						[c/FFD700:善恶错乱之世，同病相怜之人]
						[c/FFD700:放下旧日的仇恨吧！]
						[c/FFD700:现在，那个血腥大脑要为自己的兄弟报仇！]
						[c/FFD700:威胁已至，不要沉浸在过去]
						[c/D00000:你是否要去解决这一切？]
						'''
					TooltipS1F:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:貳]
						[c/FFD700:昔日的主宰已经沦落至如此不堪之境]
						[c/FFD700:曾经的争斗已成为过眼云烟]
						[c/FFD700:善恶错乱之世，同病相怜之人]
						[c/FFD700:放下旧日的仇恨吧！]
						[c/FFD700:现在，那条黑色巨蟒要为自己的兄弟报仇！]
						[c/FFD700:威胁已至，不要沉浸在过去]
						[c/D00000:你是否要去解决这一切？]
						'''
					TooltipS2S:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:弎]
						[c/FFD700:你的行为触犯了管理猩红的领主]
						[c/FFD700:所谓领主，不过是被绑在势力最高点的走狗而已]
						[c/FFD700:而且是身不由己的走狗]
						[c/FFD700:尝试摧毁它留在猩红之地的眼线]
						[c/FFD700:这或许是让它解脱的最好办法]
						[c/FFD700:叛君离道之道，愈远愈悲……]
						[c/D00000:你是否要去终结这个悲剧？]
						'''
					TooltipS2F:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:弎]
						[c/FFD700:你的行为触犯了管理腐化的领主]
						[c/FFD700:所谓领主，不过是被绑在势力最高点的走狗而已]
						[c/FFD700:而且是身不由己的走狗]
						[c/FFD700:尝试摧毁它留在腐化之地的眼线]
						[c/FFD700:这或许是让它解脱的最好办法]
						[c/FFD700:叛君离道之道，愈远愈悲……]
						[c/D00000:你是否要去终结这个悲剧？]
						'''
					TooltipS3:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:肆]
						[c/FFD700:为了在世事争纷中存活下来]
						[c/FFD700:曾经的浪客逃到了一处遗迹]
						[c/FFD700:终日不可得食，褪去身形，便留苍骷]
						[c/FFD700:渐渐的，它成为了此地的地缚灵]
						[c/FFD700:直到一名逃亡的裁缝来到此地]
						[c/FFD700:裁缝想要将这里开放，给无处可归的人们一个家]
						[c/FFD700:浪客并不认同裁缝的做法]
						[c/FFD700:裁缝最终承受了浪客的诅咒，并强行开放了这里]
						[c/FFD700:现在，裁缝就守在遗迹门口]
						[c/D00000:你是否要去探寻那些骷髅兵的秘密？]
						'''
					TooltipS4:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:伍]
						[c/FFD700:胡闹！这简直就是一场胡闹！]
						[c/FFD700:让一个史莱姆成为神明？]
						[c/FFD700:人们日益增长的狂热信仰让这个史莱姆逐渐改变……]
						[c/FFD700:越是单纯的人越会在现实的压榨下寻求极端]
						[c/D00000:你难道会允许这样的事情出现？]
						'''
					TooltipS5:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:陆]
						[c/FFD700:数亿的血肉凝聚于此]
						[c/FFD700:它们来到地狱，只为了获得更多的肮脏物质]
						[c/FFD700:古老的光明与黑暗之魂]
						[c/FFD700:一颗明星从天堂中陨落！]
						[c/FFD700:沉沦海洋在蠢蠢欲动……]
						[c/FFD700:黑暗，将由我带进坟墓]
						[c/FFD700:光明，会因你伸向未来]
						[c/D00000:就像那残酷的天使一样]
						[c/D00000:少年哟！变成神话吧！]
						'''
					TooltipS6:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:柒]
						[c/FFD700:嘉登创造出的机械造物无不令人头疼]
						[c/FFD700:几千年前便是如此，几千年后仍没有一点长进]
						[c/FFD700:现在，这些机械造物正在大地上作威作福]
						[c/D00000:逐个击破它们吧！]
						[c/D00000:或者，一鼓作气，来场热血的机械混战？]
						'''
					TooltipS7:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:捌]
						[c/FFD700:硫火女巫失败的克隆体之一罢了]
						[c/FFD700:它还不足以让你畏惧]
						[c/FFD700:生命将因死亡而得到进化，并由此重获新生]
						[c/D00000:趁着还没有实验成功的克隆体]
						[c/D00000:现在就去击破它吧！]
						'''
					TooltipS8:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:玖]
						[c/FFD700:从农田中抽枝发芽，蔓生在丛林深处的畸形怪花]
						[c/FFD700:在神明的惠土上耕种并非人民的错误]
						[c/FFD700:神明的狡黠造就了这个怪物]
						[c/FFD700:世界如此混沌，它既不公平，也不合理]
						[c/FFD700:这朵花从此封锁了丛林]
						[c/FFD700:人们失去了土地]
						[c/D00000:你是否要为了人民去铲除这个怪花吗？]
						'''
					TooltipS9:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾]
						[c/FFD700:就像是命运]
						[c/FFD700:在可怖之花诞生后不久]
						[c/FFD700:丛林深处接连不断地发生着异变]
						[c/FFD700:人们迫于深处那朵花的力量不敢前去探索]
						[c/FFD700:当你击破了那个怪物后，一个钥匙出现在你的手中]
						[c/FFD700:指引着你前去曾经的禁区中，打开那尘封的秘密]
						[c/D00000:你是否要去扯下蜥蜴人最后一块遮羞布？]
						'''
					TooltipS10:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾壹]
						[c/FFD700:在它失去了一切价值后被彻底的抛去了]
						[c/FFD700:它被传成异端的邪教徒]
						[c/FFD700:但是，这个凡人所做出的功绩不可磨灭]
						[c/FFD700:即使被抛弃，它对皓月的信仰也从未改变]
						[c/FFD700:浪迹天涯之时，恰逢碰见了你与浪客的战斗]
						[c/FFD700:你离去后，它立马占据了这里]
						[c/FFD700:它的身上有着联系月球的唯一办法]
						[c/FFD700:一个人只有让自己残酷起来，才能有机会保留自己的温柔]
						[c/CB0000:你是否要杀死这个人？？？]
						'''
					TooltipS11:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾貳]
						[c/FFD700:今夜的月色严厉而冰冷，一如寒彻的锋刃，照耀将死之人的面孔]
						[c/FFD700:月亮领主并不在乎那个人的][c/CB0000:死亡]
						[c/CB0000:但是，那个人的死亡是否影响到了你？]
						[c/FFD700:现在，天界生物已然入侵]
						[c/FFD700:天下四方动荡之时，你又怎能不顾？]
						[c/FFD700:现在你不能被那个人的死亡影响到！]
						[c/FFD700:只有经历过最黑暗的长夜，才能凝望破晓时的光明]
						[c/D00000:用你最勇猛的火焰，抵御外来者的入侵吧！]
						'''
					TooltipS12:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾弎]
						[c/FFD700:月亮领主的消亡引起了宇宙的注视……]
						[c/FFD700:你无法理解，这个星球的无数次变迁从来没被它人注意过]
						[c/FFD700:而这个星球的卫星！]
						[c/FFD700:卫星的主人被人击败了！]
						[c/FFD700:这却引起了极大的关注！]
						[c/FFD700:战胜渎火之主或许是现在最轻松的]
						[c/FFD700:这里埋藏着太多的历史、太多的秘密]
						[c/FFD700:但别担心，无论路有多长，虞金引焱始终都会在你身边……]
						[c/D00000:前会都看将是更诱人的奖励，亦或是更痛苦的深渊？]
						'''
					TooltipS13:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾肆]
						[c/FFD700:宇宙生物们来到这里做了很多对你的限制]
						[c/FFD700:封印遗迹、监视天空、把守地狱]
						[c/FFD700:它们跟随着那个寰宇巨虫]
						[c/D00000:想要驱逐宇宙的敌人，这是你的必由这路……]
						'''
					TooltipS14:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾伍]
						[c/FFD700:虚无的进入让遗迹中的骷髅兵消亡了很多]
						[c/FFD700:这些怨死者的亡魂越积越多]
						[c/FFD700:最终成为了现在你所看到的怨兽凝魂]
						[c/FFD700:无尽的复仇是正义的吗？]
						[c/FFD700:你不知道]
						[c/D00000:你是否要让骷髅兵们安息？]
						'''
					TooltipS15:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾陆]
						[c/FFD700:一条寰宇巨虫]
						[c/FFD700:自傲、不驯、强大等无数的形容词都一定符合它]
						[c/FFD700:文明本就是由一代代人的尸骨与遗言构成]
						[c/FFD700:你不前进，那就无法进步]
						[c/D00000:尝试猎杀这个巨虫]
						'''
					TooltipS16:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾柒]
						[c/FFD700:无穷尽的黑暗和孤独之中]
						[c/FFD700:不断回忆着往日的爱和希望]
						[c/FFD700:却让她的灵魂逐渐褪去了金色]
						[c/FFD700:最终，屠龙者还是成为了龙……]
						[c/D00000:尝试屠戮变节之龙]
						'''
					TooltipS17:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾捌]
						[c/FFD700:如今剩下的，便是嘉登和硫火女巫]

						   [c/9F9F9F:嘉登，一位卓越的匠人]
						   [c/FFD700:但是它完全就是一个全无道德的野兽]
						   [c/FFD700:人性？同情？你根本不可能从他身上看到丝毫！]
						   [c/FFA500:灾厄，一位厄运的巫师]
						   [c/FFD700:曾几何时，她也是个惹人怜爱的女孩]
						   [c/FFD700:而今变成了彻底的女巫]
						   
						[c/D00000:请你与它们完成一场演出]
						'''
					TooltipS18:
						'''
						{$CommonTooltip}

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:拾玖]
						[c/FFD700:混沌精本不是这个世界的生物]
						[c/FFD700:它们不能控制自己的力量，偶然来到此地]
						[c/FFD700:不知为何，寒泉冽冽之中唯一能够存活的生物对此有极大的反应]
						[c/D00000:请你去解开这最后的谜团]
						'''
					TooltipS19:
						'''
						[c/FF0000:你还要继续前行吗？]
						[c/FF0000:我是命运的信徒，命运如此，那我便无怨言]

						[c/EE00FF:〔登神长阶〕] - [c/FFE8E8:终]
						[c/FFD700:告别过去，是为了走向未来]
						[c/FFD700:此后，将有群星闪耀，因为我如今来过]
						[c/FFD700:此后，将有百花绽放，因为我从未离去]
						[c/CB0000:“而今天，神也将臣服于我”]
						'''
				}

				TheGoldenFirePROJ.DisplayName: 虞金引焱
				TheGoldenFirePROJAG.DisplayName: The Golden Fire P R O J A G

				TheGoldenFireNoGrow: {
					DisplayName: The Golden Fire No Grow
					Tooltip: ""
				}

				TheGoldenFirePROJGrow.DisplayName: The Golden Fire P R O J Grow
			}
		}
	}
}
