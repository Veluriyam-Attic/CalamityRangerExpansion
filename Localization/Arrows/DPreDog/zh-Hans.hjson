Mods: {
	CalamityRangerExpansion: {
		Arrows: {
			DPreDog: {
				DivineGeodeArrow: {
					DisplayName: 神圣晶石箭
					Tooltip:
						'''
						小心电离辐射！
						以神圣之力把敌人炸成碎片
						赋予玩家「净化邪神」增益
						这将大幅提升你的飞行时间
						“不要重蹈覆辙……”
						'''
				}
		
				EffulgentFeatherArrow: {
					DisplayName: 闪耀金羽箭
					Tooltip:
