			EAfterDog: {
				AuricBulet: {
					DisplayName: 金源弹
					Tooltip:
						'''
						击中敌人时爆发出多个不断在原地公转的金源珠
						“我就说嘛！悠悠球得多了才行！”
						'''
				}

				MiracleMatterBullet: {
					DisplayName: 星流弹
					Tooltip:
						'''
						第1次碰撞不造成伤害
